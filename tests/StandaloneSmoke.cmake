if(NOT EXISTS "${GAME}" OR NOT WORK)
    message(FATAL_ERROR "Standalone check requires GAME and WORK")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(root "${WORK}/${run}")
# Deep enough that the development asset search could not find the repository.
set(isolated "${root}/one/two/three/four/five/six/seven")
file(MAKE_DIRECTORY "${isolated}")
get_filename_component(name "${GAME}" NAME)
file(COPY_FILE "${GAME}" "${isolated}/${name}")
if(GRAPHICS)
    set(arguments --smoke-test --screenshot "${WORK}/Standalone_Startup.png")
else()
    set(arguments --verify-assets)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DUNGEON_DESCENT_CACHE=${root}/cache"
    "${isolated}/${name}" ${arguments} WORKING_DIRECTORY "${isolated}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Isolated single-executable launch failed: ${status}\n${output}\n${errors}")
endif()
file(GLOB markers "${root}/cache/*/.complete")
list(LENGTH markers count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Standalone launch did not use its embedded asset cache")
endif()
file(GLOB files "${isolated}/*")
list(LENGTH files count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Standalone executable required or created extra files beside itself")
endif()
if(NOT GRAPHICS)
    list(GET markers 0 marker)
    get_filename_component(cache "${marker}" DIRECTORY)
    file(WRITE "${cache}/textfiles/riddles/1/EasyRiddles.txt" "broken cache")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DUNGEON_DESCENT_CACHE=${root}/cache"
        "${isolated}/${name}" --verify-assets WORKING_DIRECTORY "${isolated}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Embedded cache repair failed: ${output}\n${errors}")
    endif()
endif()
file(REMOVE_RECURSE "${root}")
message(STATUS "Single-executable isolation check passed")
